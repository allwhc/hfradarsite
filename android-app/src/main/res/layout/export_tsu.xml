<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HomeInventory">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#5fb0c9"
        android:orientation="vertical">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:orientation="horizontal"
            android:layout_below="@+id/txtHdr"
            android:id="@+id/linear_layout_5"
            android:padding="2dp">
            <!-- Password Label -->
            <TextView
                android:id="@+id/txttrfl"
                android:layout_width="fill_parent"
                android:layout_height="40dp"
                android:textColor="#FF4081"
                android:text="                 SEND DATA              "
                android:textSize="25dp"
                android:textStyle="bold"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="1dip"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linear_layout_22"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/linear_layout_5"
            android:padding="10dp"
            android:weightSum="2">

            <RelativeLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/login_title"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginTop="1dp"
                android:background="#fff"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="4dp">

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp">
                    <RelativeLayout
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="5dp"
                        android:paddingBottom="4dp">

                        <TextView
                            android:id="@+id/textP"
                            android:layout_width="100dp"
                            android:layout_height="40dp"
                            android:layout_alignParentLeft="true"
                            android:textColor="@android:color/black"
                            android:text=" "
                            android:textSize="16sp"
                            />

                        <Button
                            android:id="@+id/btnId1"
                            android:layout_width="30dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="2dp"
                            android:layout_toRightOf="@id/textP"
                            android:background="#d67601"
                            android:text=" &lt; "
                            android:textAllCaps="false"
                            android:textColor="#fff"
                            android:textSize="18sp"

                            />


                        <TextView
                            android:id="@+id/textId"
                            android:layout_width="100dp"
                            android:layout_height="40dp"
                            android:layout_toRightOf="@id/btnId1"
                            android:text=""
                            android:textColor="@android:color/black"
                            android:textSize="18sp" />

                        <Button
                            android:id="@+id/btnId2"
                            android:layout_width="30dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:layout_marginLeft="2dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="2dp"
                            android:layout_marginRight="2dp"
                            android:layout_marginBottom="2dp"
                            android:layout_toRightOf="@id/textId"
                            android:background="#d67601"
                            android:text=" &gt; "
                            android:textAllCaps="false"
                            android:textColor="#fff"
                            android:textSize="18sp" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <Button
                            android:id="@+id/btnLc1"
                            android:layout_width="30dp"
                            android:layout_height="wrap_content"
                            android:layout_alignParentLeft="true"
                            android:layout_marginStart="2dp"
                            android:layout_marginLeft="2dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="2dp"
                            android:layout_marginRight="2dp"

                            android:layout_marginBottom="2dp"
                            android:background="#d67601"
                            android:text=" &lt; "
                            android:textAllCaps="false"
                            android:textColor="#fff"
                            android:textSize="18sp" />


                        <TextView
                            android:id="@+id/textMon"
                            android:layout_width="60dp"
                            android:layout_height="40dp"
                            android:layout_toRightOf="@id/btnLc1"
                            android:text=""
                            android:textColor="@android:color/black"
                            android:textSize="18sp" />

                        <Button
                            android:id="@+id/btnLc2"
                            android:layout_width="30dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:layout_marginLeft="2dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="2dp"
                            android:layout_marginRight="2dp"
                            android:layout_marginBottom="2dp"
                            android:layout_toRightOf="@id/textMon"
                            android:background="#d67601"
                            android:text=" &gt; "
                            android:textAllCaps="false"
                            android:textColor="#fff"
                            android:textSize="18sp" />


                        <Button
                            android:id="@+id/btnRc1"
                            android:layout_width="30dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="2dp"
                            android:layout_toRightOf="@id/btnLc2"
                            android:background="#d67601"
                            android:text=" &lt; "
                            android:textAllCaps="false"
                            android:textColor="#fff"
                            android:textSize="18sp"

                            />


                        <TextView
                            android:id="@+id/textYr"
                            android:layout_width="60dp"
                            android:layout_height="40dp"
                            android:layout_toRightOf="@id/btnRc1"
                            android:textColor="@android:color/black"
                            android:text=""
                            android:textSize="18sp"
                            />

                        <Button
                            android:id="@+id/btnRc2"
                            android:layout_width="30dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="2dp"
                            android:layout_toRightOf="@id/textYr"
                            android:background="#d67601"
                            android:text=" &gt; "
                            android:textAllCaps="false"
                            android:textColor="#fff"
                            android:textSize="18sp"
                            />
                    </RelativeLayout>


                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linear_layout_21"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/linear_layout_22"
            android:padding="10dp"
            android:weightSum="2">

            <RelativeLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/login_title"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginTop="1dp"
                android:background="#fff"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="4dp">


                <RelativeLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp">

                    <Button
                        android:id="@+id/btnList"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="2dp"
                        android:layout_alignParentLeft="true"
                        android:background="#d67601"
                        android:text="DISPLAY"
                        android:textAllCaps="false"
                        android:textColor="#fff"
                        android:textSize="18sp"
                        />

                    <Button
                        android:id="@+id/btnScan"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="2dp"
                        android:layout_toRightOf="@id/btnList"
                        android:background="#d67601"
                        android:text="SCAN"
                        android:textAllCaps="false"
                        android:textColor="#fff"
                        android:textSize="18sp"
                        />

                    <Button
                        android:id="@+id/btnGo"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="2dp"
                        android:layout_toRightOf="@id/btnScan"
                        android:background="#d67601"
                        android:text="SEND"
                        android:textAllCaps="false"
                        android:textColor="#fff"
                        android:textSize="18sp"
                        />

                </RelativeLayout>

            </RelativeLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linear_layout_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/linear_layout_21"
            android:padding="10dp"
            android:background="#f6f6f6"
            android:weightSum="1">
            <TextView
                android:id="@+id/textMsg"
                android:layout_width="350dp"
                android:layout_height="40dp"
                android:layout_toRightOf="@id/btnRc1"
                android:textColor="@android:color/black"
                android:text=""
                android:textSize="18sp"
                />
            <ScrollView
                android:id="@+id/scrollView1"
                android:layout_width="match_parent"
                android:layout_height="fill_parent"
                android:layout_below="@+id/linear_layout_2"
                android:layout_alignParentLeft="true" >

                <HorizontalScrollView
                    android:id="@+id/hscrll1"
                    android:layout_width="match_parent"
                    android:layout_height="fill_parent" >


                    <TableLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent">

                        <TableRow
                            android:id="@+id/trow1"
                            android:background="#C0C0C0"
                            android:weightSum="3">

                            <TextView
                                android:layout_width="100dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="ID"
                                android:textColor="@android:color/black"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="100dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="DATE"
                                android:textColor="@android:color/black"
                                android:textStyle="bold"></TextView>

                            <TextView
                                android:layout_width="100dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="RADIAL CNT"
                                android:textColor="@android:color/black"
                                android:textStyle="bold"></TextView>
                        </TableRow>

                        <TableLayout
                            android:background="#C0C0C0"
                            android:id="@+id/table_main"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"></TableLayout>


                    </TableLayout>

                </HorizontalScrollView>
            </ScrollView>
        </LinearLayout>


    </RelativeLayout>
</FrameLayout>

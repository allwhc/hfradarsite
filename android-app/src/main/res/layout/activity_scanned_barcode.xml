<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Header -->
    <TextView
        android:id="@+id/tvScanTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:padding="16dp"
        android:text="Scan QR Code"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center" />

    <!-- Scanner Preview Container (Centered Box) -->
    <FrameLayout
        android:id="@+id/scannerContainer"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_centerInParent="true"
        android:background="@android:color/black">

        <SurfaceView
            android:id="@+id/surfaceView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Scanner Frame Overlay -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/scanner_frame" />

    </FrameLayout>

    <!-- Status Text -->
    <TextView
        android:id="@+id/txtBarcodeValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/scannerContainer"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="24dp"
        android:text="Point camera at QR code"
        android:textColor="@android:color/white"
        android:textSize="16sp" />

    <!-- Button Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Cancel Button -->
        <Button
            android:id="@+id/btnCancel"
            android:layout_width="200dp"
            android:layout_height="48dp"
            android:text="CANCEL"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_cancel_background" />

        <!-- Load from Gallery Button -->
        <Button
            android:id="@+id/btnGallery"
            android:layout_width="200dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="LOAD FROM GALLERY"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_cancel_background" />

    </LinearLayout>

</RelativeLayout>
